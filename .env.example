# Pet AI Content Factory 环境变量模板
# 复制为 .env 并填入真实值。.env 已在 .gitignore 中，不会被提交。
# 所有 Key 只从此处或环境变量读取，绝不会写入前端代码或日志。

# ===== DeepSeek（默认关闭，可选）=====
# 默认方案是「桌面豆包 + 本地」，不需要任何 API Key，也不会产生费用。
# 只有当你手动把 PetAI/config/petai.toml 的 [services].deepseek 改为 true、
# [script].engine 改为 deepseek 时，才需要取消下面两行的注释并填写。
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===== 以下付费服务默认关闭，仅当用户主动开启并填入 Key 后才可能调用 =====
# PETAI_AI_IMAGE_API_KEY=
# PETAI_AI_VIDEO_API_KEY=
# PETAI_ONLINE_TTS_API_KEY=
